{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lipton Thés",
  "version": "1.0.0",
  "identifier": "com.maxlestage.liptonthes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lipton Thés",
        "width": 1100,
        "height": 860,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Lifestyle",
    "shortDescription": "Sachets de thé Lipton triés par couleurs",
    "longDescription": "La gamme Lipton vendue en France, triée par couleurs, avec fiche colorée, intensité et ingrédients. Fonctionne hors-ligne.",
    "copyright": "© Maxime Nathan Lestage",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
