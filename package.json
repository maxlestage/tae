{
  "name": "lipton-tea-colors",
  "version": "1.0.0",
  "description": "Sachets de thé Lipton triés par couleurs, avec une fiche colorée aux couleurs du thé ou de sa boîte.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
